<!-- 폼 주변에 배치하는 즉시 연결 버튼 (.env의 연락처 사용) -->
<!-- 전화번호는 화면에 노출하지 않는다. 버튼을 누르면 tel: 링크로 바로 연결된다. -->
<div class="grid grid-cols-2 gap-2.5">
  <a href="<%= contactPhoneHref %>" aria-label="전화로 바로 상담하기"
     class="flex min-h-[56px] items-center justify-center gap-2 rounded-2xl border border-brand-200 bg-brand-50 px-3 py-2.5 transition active:bg-brand-100">
    <img src="/images/call.png" alt="" aria-hidden="true" width="20" height="20"
         class="h-5 w-5 shrink-0 object-contain">
    <span class="text-[13px] font-bold text-brand-700">바로 전화하기</span>
  </a>
  <a href="<%= kakaoUrl %>" target="_blank" rel="noopener noreferrer" aria-label="카카오톡 오픈채팅으로 상담하기"
     class="flex min-h-[56px] items-center justify-center gap-2 rounded-2xl border border-yellow-300 bg-yellow-50 px-3 py-2.5 transition active:bg-yellow-100">
    <img src="/images/kakaotalk.png" alt="" aria-hidden="true" width="20" height="20"
         class="h-5 w-5 shrink-0 rounded-[5px] object-contain">
    <span class="text-[13px] font-bold text-[#3C1E1E]">카카오톡 상담</span>
  </a>
</div>
