<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-3xl items-center justify-between px-4">
    <a href="/" class="flex items-center gap-2 font-bold text-slate-900">
      <span class="text-base font-extrabold tracking-tight"><%= siteName %></span>
    </a>

    <nav class="flex items-center gap-1">
      <a href="/consultation"
         class="rounded-lg px-3 py-1.5 text-xs font-bold transition <%= currentPath.startsWith('/consultation') ? 'bg-brand-50 text-brand-700' : 'text-slate-600 hover:bg-slate-100' %>">
        설계신청
      </a>
      <a href="/claim"
         class="rounded-lg px-3 py-1.5 text-xs font-bold transition <%= currentPath.startsWith('/claim') ? 'bg-amber-50 text-amber-700' : 'text-slate-600 hover:bg-slate-100' %>">
        청구신청
      </a>
    </nav>
  </div>
</header>
