<!DOCTYPE html>
<html lang="ko">
<head>
  <%- include('partials/head') %>
  <meta name="robots" content="noindex">
</head>
<body class="bg-slate-50 font-sans text-slate-900 antialiased selection:bg-brand-600 selection:text-white">
  <%- include('partials/header') %>

  <main class="mx-auto max-w-3xl px-4 pb-28 sm:pb-8">

    <section class="mt-8 rounded-3xl border border-slate-200 bg-white p-6 text-center shadow-xl sm:p-8">
      <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-mint-50 text-mint-500 ring-8 ring-mint-50/50">
        <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 13l4 4L19 7"/>
        </svg>
      </div>

      <h1 class="mt-5 text-xl font-black text-slate-900"><%= heading %></h1>
      <p class="mt-3 whitespace-pre-line text-[15px] leading-relaxed text-slate-600"><%= message %></p>

      <% if (notice) { %>
      <div class="mt-5 rounded-2xl bg-amber-50 p-4 text-left">
        <p class="text-sm leading-relaxed text-amber-900"><%= notice %></p>
      </div>
      <% } %>
    </section>

    <section class="mt-5 rounded-3xl border border-slate-200 bg-white p-4 shadow-sm">
      <h2 class="text-[15px] font-bold text-slate-900">연락이 급하신가요?</h2>
      <p class="mt-1 mb-3 text-sm text-slate-600">아래로 연락 주시면 바로 확인해드리겠습니다.</p>
      <%- include('partials/contact-buttons') %>
    </section>

    <div class="mt-5 text-center">
      <a href="/" class="inline-flex h-12 w-full items-center justify-center rounded-xl bg-slate-100 text-sm font-bold text-slate-700 transition hover:bg-slate-200">
        홈으로 돌아가기
      </a>
    </div>

  </main>

  <%- include('partials/footer') %>
  <%- include('partials/floating-contact') %>
  <script src="/js/app.js" defer></script>
</body>
</html>
