<!-- 모바일: 화면 하단 고정 바 / 데스크톱: 우측 하단 플로팅 버튼 -->
<!-- 전화번호는 화면에 노출하지 않는다. 버튼을 누르면 tel: 링크로 바로 연결된다. -->
<div class="fixed inset-x-0 bottom-0 z-50 border-t border-slate-200 bg-white/95 shadow-float backdrop-blur-md pb-[env(safe-area-inset-bottom)] sm:hidden">
  <div class="grid grid-cols-2 gap-2 p-2.5">
    <a href="<%= contactPhoneHref %>" aria-label="전화로 바로 상담하기"
       class="flex h-13 min-h-[52px] items-center justify-center gap-2 rounded-xl bg-brand-600 text-base font-bold text-white shadow-sm transition active:bg-brand-700">
      <img src="/images/call.png" alt="" aria-hidden="true" width="20" height="20"
           class="icon-invert h-5 w-5 shrink-0 object-contain">
      전화 상담
    </a>
    <a href="<%= kakaoUrl %>" target="_blank" rel="noopener noreferrer" aria-label="카카오톡 오픈채팅으로 상담하기"
       class="flex h-13 min-h-[52px] items-center justify-center gap-2 rounded-xl bg-kakao text-base font-bold text-[#3C1E1E] shadow-sm transition active:brightness-95">
      <img src="/images/kakaotalk.png" alt="" aria-hidden="true" width="20" height="20"
           class="h-5 w-5 shrink-0 rounded-[5px] object-contain">
      카카오톡 상담
    </a>
  </div>
</div>

<div class="fixed bottom-6 right-6 z-50 hidden flex-col gap-3 sm:flex">
  <a href="<%= kakaoUrl %>" target="_blank" rel="noopener noreferrer" aria-label="카카오톡 오픈채팅으로 상담하기"
     class="flex items-center gap-2 rounded-full bg-kakao px-5 py-3 text-sm font-bold text-[#3C1E1E] shadow-lg transition hover:scale-105 hover:brightness-95 active:scale-95">
    <img src="/images/kakaotalk.png" alt="" aria-hidden="true" width="20" height="20"
         class="h-5 w-5 shrink-0 rounded-[5px] object-contain">
    카카오톡 상담
  </a>
  <a href="<%= contactPhoneHref %>" aria-label="전화로 바로 상담하기"
     class="flex items-center gap-2 rounded-full bg-brand-600 px-5 py-3 text-sm font-bold text-white shadow-lg transition hover:scale-105 hover:bg-brand-700 active:scale-95">
    <img src="/images/call.png" alt="" aria-hidden="true" width="20" height="20"
         class="icon-invert h-5 w-5 shrink-0 object-contain">
    전화 상담
  </a>
</div>
