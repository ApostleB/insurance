<!DOCTYPE html>
<html lang="ko">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-slate-50 font-sans text-slate-900 antialiased">
  <%- include('partials/header') %>

  <main class="mx-auto max-w-3xl px-4 pb-28 sm:pb-8">

    <!-- 프로필 카드 -->
    <section class="mt-5 overflow-hidden rounded-3xl bg-gradient-to-br from-brand-600 to-brand-800 shadow-lg">
      <div class="px-6 pt-7 pb-6 text-white">
        <span class="inline-flex items-center rounded-full bg-white/15 px-3 py-1 text-xs font-semibold tracking-wide">
          독립 보험설계사
        </span>
        <h1 class="mt-4 text-[26px] font-extrabold leading-tight sm:text-3xl">
          여러 보험사를<br class="sm:hidden"> 한 번에 비교해드립니다
        </h1>
        <p class="mt-3 text-[15px] leading-relaxed text-brand-50/90">
          한 회사 상품만 권하지 않습니다.<br>
          <b class="font-bold text-white"><%= agentName %></b> 설계사가 여러 보험사를 함께 비교해
          고객님께 꼭 필요한 보장만 골라 설계해드립니다.
        </p>

        <div class="mt-6 grid grid-cols-2 gap-2.5">
          <a href="/consultation"
             class="flex min-h-[52px] items-center justify-center rounded-xl bg-white text-[15px] font-bold text-brand-700 shadow-sm transition active:bg-brand-50">
            설계 신청하기
          </a>
          <a href="/claim"
             class="flex min-h-[52px] items-center justify-center rounded-xl bg-brand-500/40 text-[15px] font-bold text-white ring-1 ring-inset ring-white/40 transition active:bg-brand-500/60">
            보험금 청구하기
          </a>
        </div>
      </div>
    </section>

    <!-- 강점 -->
    <section class="mt-8">
      <h2 class="px-1 text-lg font-bold text-slate-900">이렇게 도와드립니다</h2>
      <div class="mt-3 space-y-3">
        <% strengths.forEach(function (item) { %>
        <article class="flex gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-xl">
            <%= item.icon %>
          </div>
          <div class="min-w-0">
            <h3 class="text-[15px] font-bold text-slate-900"><%= item.title %></h3>
            <p class="mt-1 text-sm leading-relaxed text-slate-600"><%= item.body %></p>
          </div>
        </article>
        <% }); %>
      </div>
    </section>

    <!-- 취급 보험사 -->
    <section class="mt-8">
      <h2 class="px-1 text-lg font-bold text-slate-900">취급 보험사</h2>
      <p class="mt-1 px-1 text-sm text-slate-500">아래 보험사 상품을 함께 비교해 안내드립니다.</p>

      <div class="mt-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <% ['생명보험', '손해보험'].forEach(function (category) { %>
        <div class="[&:not(:first-child)]:mt-5">
          <h3 class="text-xs font-bold tracking-wide text-slate-400"><%= category.toUpperCase() %></h3>
          <ul class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-3">
            <% insurers.filter(function (i) { return i.category === category; }).forEach(function (insurer) { %>
            <li class="flex min-h-[44px] items-center justify-center rounded-xl bg-slate-50 px-2 text-center text-[13px] font-semibold text-slate-700">
              <%= insurer.name %>
            </li>
            <% }); %>
          </ul>
        </div>
        <% }); %>

        <p class="mt-5 text-xs leading-relaxed text-slate-400">
          ※ 위 목록 외 보험사 상품도 상담 가능하며, 취급 보험사는 변경될 수 있습니다.
        </p>
      </div>
    </section>

    <!-- 신청 안내 -->
    <section class="mt-8">
      <h2 class="px-1 text-lg font-bold text-slate-900">무엇을 도와드릴까요?</h2>
      <div class="mt-3 space-y-3">
        <a href="/consultation"
           class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition active:bg-slate-50">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-600 text-xl text-white">📝</div>
          <div class="min-w-0 flex-1">
            <h3 class="text-[15px] font-bold text-slate-900">설계신청</h3>
            <p class="mt-0.5 text-sm text-slate-600">보험 가입·보장 분석 상담을 신청합니다.</p>
          </div>
          <span class="text-slate-300">›</span>
        </a>

        <a href="/claim"
           class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition active:bg-slate-50">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-amber-500 text-xl text-white">🧾</div>
          <div class="min-w-0 flex-1">
            <h3 class="text-[15px] font-bold text-slate-900">청구신청</h3>
            <p class="mt-0.5 text-sm text-slate-600">보험금 청구를 접수합니다. 서류는 통화하며 안내드립니다.</p>
          </div>
          <span class="text-slate-300">›</span>
        </a>
      </div>
    </section>

    <!-- 즉시 연결 -->
    <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <h2 class="text-[15px] font-bold text-slate-900">바로 물어보고 싶으신가요?</h2>
      <p class="mt-1 mb-3 text-sm text-slate-600">신청서 작성 없이 전화나 카카오톡으로 편하게 물어보세요.</p>
      <%- include('partials/contact-buttons') %>
    </section>

  </main>

  <%- include('partials/footer') %>
  <%- include('partials/floating-contact') %>
  <script src="/js/app.js" defer></script>
</body>
</html>
