<!DOCTYPE html>
<html lang="ko">
<head>
  <%- include('partials/head') %>
  <meta name="robots" content="noindex">
</head>
<body class="bg-slate-50 font-sans text-slate-900 antialiased">
  <%- include('partials/header') %>

  <main class="mx-auto max-w-3xl px-4 pb-28 sm:pb-8">

    <section class="mt-8 rounded-3xl border border-slate-200 bg-white p-6 text-center shadow-sm">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-green-100">
        <svg class="h-8 w-8 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 6 9 17l-5-5"/>
        </svg>
      </div>

      <h1 class="mt-5 text-xl font-extrabold text-slate-900"><%= heading %></h1>
      <p class="mt-3 whitespace-pre-line text-[15px] leading-relaxed text-slate-600"><%= message %></p>

      <% if (notice) { %>
      <div class="mt-5 rounded-2xl bg-amber-50 p-4 text-left">
        <p class="text-sm leading-relaxed text-amber-900"><%= notice %></p>
      </div>
      <% } %>
    </section>

    <section class="mt-5 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <h2 class="text-[15px] font-bold text-slate-900">연락이 급하신가요?</h2>
      <p class="mt-1 mb-3 text-sm text-slate-600">아래로 연락 주시면 바로 확인해드리겠습니다.</p>
      <%- include('partials/contact-buttons') %>
    </section>

    <div class="mt-5 text-center">
      <a href="/" class="inline-flex h-12 items-center justify-center rounded-xl border border-slate-300 bg-white px-6 text-sm font-bold text-slate-700 transition active:bg-slate-50">
        홈으로 돌아가기
      </a>
    </div>

  </main>

  <%- include('partials/footer') %>
  <%- include('partials/floating-contact') %>
  <script src="/js/app.js" defer></script>
</body>
</html>
