<!DOCTYPE html>
<html lang="ko">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-slate-50 font-sans text-slate-900 antialiased selection:bg-brand-600 selection:text-white">
  <%- include('partials/header') %>

  <main class="mx-auto max-w-3xl px-4 pb-28 sm:pb-8">

    <!-- 프로필 카드 -->
    <section class="relative mt-5 overflow-hidden rounded-3xl bg-gradient-to-br from-brand-900 via-brand-800 to-brand-700 shadow-glow">
      <!-- 배경 장식 원형 효과 -->
      <div class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-brand-500/20 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-16 -left-16 h-64 w-64 rounded-full bg-mint-500/15 blur-3xl"></div>

      <div class="relative z-10 px-6 pt-7 pb-6 text-white">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-3.5 py-1 text-xs font-bold text-mint-100 backdrop-blur-md">
          <span class="h-2 w-2 rounded-full bg-mint-400 animate-pulse"></span>
          보험설계사
        </span>
        <h1 class="mt-4 text-[26px] font-black leading-snug sm:text-3xl">
          여러 보험사를<br class="sm:hidden"> 한 번에 비교해드립니다
        </h1>
        <p class="mt-3 text-[15px] leading-relaxed text-brand-100/90">
          한 회사 상품만 권하지 않습니다.<br>
          <b class="font-bold text-white"><%= agentName %></b> 설계사가 여러 보험사를 함께 비교해
          고객님께 꼭 필요한 보장만 골라 설계해드립니다.
        </p>

        <div class="mt-6 grid grid-cols-2 gap-2.5">
          <a href="/consultation"
             class="flex min-h-[52px] items-center justify-center rounded-2xl bg-white text-[15px] font-extrabold text-brand-900 shadow-md transition active:scale-[0.98] active:bg-brand-50">
            설계 신청하기
          </a>
          <a href="/claim"
             class="flex min-h-[52px] items-center justify-center rounded-2xl bg-white/15 text-[15px] font-extrabold text-white ring-1 ring-inset ring-white/30 backdrop-blur-sm transition active:scale-[0.98] active:bg-white/20">
            보험금 청구하기
          </a>
        </div>
      </div>
    </section>

    <!-- 이야기 슬라이드 (노출할 글이 없으면 JS가 숨긴 채로 둔다) -->
    <section id="story-slider" class="mt-8 hidden">
      <div class="mb-3 flex items-end justify-between px-1">
        <h2 class="text-lg font-bold text-slate-900">이야기</h2>
        <a href="/story" class="text-xs font-semibold text-brand-600 hover:underline">전체 보기 →</a>
      </div>
      <!--
        touch-action: pan-y — 가로 제스처를 브라우저 스크롤로 넘기지 않고 슬라이더가 직접 처리한다.
        이게 없으면 스와이프할 때 페이지 전체가 함께 끌려간다. (public/js/story-slider.js)
      -->
      <div data-slider-viewport style="touch-action: pan-y"
           class="relative aspect-[16/10] overflow-hidden rounded-3xl bg-slate-200 shadow-sm">
        <!-- 슬라이드를 가로로 늘어놓고 트랙 전체를 translateX로 민다 -->
        <div data-slider-track class="flex h-full w-full will-change-transform"></div>
        <!-- 도트 버튼은 커서로 누를 수 있도록 24px 높이의 히트 영역을 갖는다.
             보이는 막대는 버튼 안쪽 span이라 bottom/gap으로 위치를 보정한다. (story-slider.js) -->
        <div data-slider-dots class="absolute bottom-1 left-1/2 z-20 flex -translate-x-1/2 items-center gap-0"></div>
      </div>
    </section>

    <!-- 즉시 연결 -->
    <section class="mt-8 rounded-3xl border border-slate-200 bg-white p-4 shadow-sm">
      <h2 class="text-[15px] font-bold text-slate-900">바로 물어보고 싶으신가요?</h2>
      <p class="mt-1 mb-3 text-sm text-slate-600">신청서 작성 없이 전화나 카카오톡으로 편하게 물어보세요.</p>
      <%- include('partials/contact-buttons') %>
    </section>

  </main>

  <%- include('partials/footer') %>
  <%- include('partials/floating-contact') %>
  <script src="/js/app.js" defer></script>
  <script src="/js/story-slider.js" defer></script>
</body>
</html>
